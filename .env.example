# Copy this file to .env and paste keys from https://dashboard.stripe.com/apikeys
# Use sk_test_ / pk_test_ until you are ready to take live payments.

STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PORT=4242
# Optional. Set this on Vercel to your live https URL, for example
# https://www.dapormillionaires.com
# Leave it unset locally. Checkout then uses the current host.
DOMAIN=
